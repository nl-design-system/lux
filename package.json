{
  "version": "1.0.0-alpha.0",
  "author": "Logius",
  "description": "Design system based on the NL Design System architecture",
  "license": "EUPL-1.2",
  "name": "@lux-design-system/design-system",
  "keywords": [
    "nl-design-system",
    "lux",
    "logius"
  ],
  "private": true,
  "engines": {
    "node": "^24.22.3 || ^26.13.1",
    "pnpm": "^12"
  },
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/lux.git",
    "directory": "."
  },
  "volta": {
    "node": "24.22.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "26.6.6",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "3.1.1",
    "eslint-plugin-mdx": "3.7.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.4.0",
    "husky": "9.1.4",
    "lint-staged": "15.2.8",
    "markdownlint-cli": "0.41.0",
    "npm-check-updates": "22.2.9",
    "npm-package-json-lint": "8.0.0",
    "npm-run-all": "4.1.5",
    "postcss": "8.4.41",
    "prettier": "3.8.1",
    "prettier-plugin-css-order": "2.1.2",
    "stylelint": "16.8.1",
    "stylelint-config-standard-scss": "13.1.0",
    "stylelint-order": "6.0.4",
    "typescript": "5.5.4",
    "typescript-eslint": "8.56.1"
  },
  "scripts": {
    "build": "pnpm run --recursive build",
    "changeset": "changeset",
    "clean": "pnpm run --recursive clean",
    "lint": "pnpm run --recursive lint && pnpm run --aggregate-output --if-present '/^lint:.*/'",
    "lint:css": "stylelint --allow-empty-input '**/*.{css,scss}'",
    "lint:js": "eslint --report-unused-disable-directives .",
    "lint:md": "markdownlint '**/*.md'",
    "lint:package-json": "npmPkgJsonLint '**/package.json'",
    "lint:package-lock": "pnpm ls --recursive",
    "lint-fix": "npm-run-all --continue-on-error lint-fix:** prettier",
    "lint-fix:css": "stylelint --fix '**/*.{css,scss}'",
    "lint-fix:js": "eslint --fix --report-unused-disable-directives .",
    "lint-fix:md": "markdownlint --fix '**/*.md'",
    "lint-build": "pnpm run --if-present --recursive lint-build",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "publish": "changeset publish",
    "publish:canary": "changeset publish --tag canary",
    "start": "node_modules/http-server/bin packages/storybook/dist/",
    "storybook": "npm-run-all --parallel watch:**",
    "test": "pnpm run --if-present --recursive test",
    "test-update": "npm-run-all --sequential clean lint build test",
    "prewatch:storybook": "pnpm run --recursive build:stencil && pnpm run --recursive build:tokens-studio",
    "update-patch": "npm-check-updates --configFileName .ncurc.patch.mjs",
    "update-minor": "npm-check-updates --configFileName .ncurc.minor.mjs",
    "update-major": "npm-check-updates --configFileName .ncurc.major.mjs",
    "version": "changeset version",
    "version:canary": "changeset version --snapshot canary",
    "watch:storybook": "pnpm run --filter @lux-design-system/storybook storybook",
    "watch:tokens-studio": "pnpm run --filter @lux-design-system/design-tokens watch:tokens-studio"
  },
  "dependencies": {
    "http-server": "14.1.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
